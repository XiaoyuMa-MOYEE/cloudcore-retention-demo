{
  "$schema": "../../web/node_modules/wrangler/config-schema.json",
  "name": "cloudcore-retention-api-proxy",
  "main": "api-proxy.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "routes": [
    { "pattern": "cloudcore.moyee.uk/api/*", "zone_name": "moyee.uk" },
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://REPLACE_WITH_PRIVATE_BACKEND_HOST",
  },
}
