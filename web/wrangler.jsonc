{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudcore-retention-demo",
  "main": "./api-proxy.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    { "pattern": "cloudcore.moyee.uk/*", "zone_name": "moyee.uk" },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
