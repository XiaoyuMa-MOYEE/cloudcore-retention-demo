    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
